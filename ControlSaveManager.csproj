<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- I test hanno il loro progetto. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;dist/**;scripts/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dati del prodotto: compaiono nelle proprietà dell'exe. Version è l'unica da cambiare a ogni rilascio. -->
    <Version>0.9.0</Version>
    <Product>Control Save Manager</Product>
    <AssemblyTitle>Control Save Manager</AssemblyTitle>
    <Description>Gestione di più profili di salvataggio per Control (Steam).</Description>
    <Company>Andrix64</Company>
    <Authors>Andrix64</Authors>
    <Copyright>© 2026 Andrix64</Copyright>
    <NeutralLanguage>it-IT</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!--
      Smart App Control giudica ogni dll non firmata in base al suo hash e a
      volte blocca una build. Con una build non deterministica ogni compilazione
      produce un file diverso: se una viene bloccata, basta ricompilare.
    -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icona delle finestre (Theme.AppIcon). -->
    <EmbeddedResource Include="app.ico" LogicalName="ControlSaveManager.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlSaveManager.Tests" />
  </ItemGroup>

</Project>
