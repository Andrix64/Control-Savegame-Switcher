<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LssSpike.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- Colori del tema scuro di oggi (Theme.cs). -->
    <SolidColorBrush x:Key="Background" Color="#0F0F10" />
    <SolidColorBrush x:Key="Header" Color="#0A0A0B" />
    <SolidColorBrush x:Key="Surface" Color="#19191B" />
    <SolidColorBrush x:Key="Border" Color="#2E2E33" />
    <SolidColorBrush x:Key="Accent" Color="#E0261B" />
    <SolidColorBrush x:Key="TextDim" Color="#96969C" />
    <SolidColorBrush x:Key="WarningBack" Color="#2A2110" />
    <SolidColorBrush x:Key="WarningBorder" Color="#5C4515" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.card.active">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>

</Application>
