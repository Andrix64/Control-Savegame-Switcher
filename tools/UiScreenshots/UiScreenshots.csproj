<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Strumento per lo sviluppo: disegna ogni finestra dell'app con dati finti in
    una cartella temporanea e la salva come PNG, per controllarne l'aspetto
    senza aprire l'app sui dati veri. Uso (dalla cartella del repository):
      dotnet run, con il progetto tools/UiScreenshots, cartella di uscita e lingua (it o en)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lss.UiScreenshots</RootNamespace>
    <AssemblyName>Lss.UiScreenshots</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Smart App Control a volte blocca una build: ricompilando cambia il file (vedi DEVELOPMENT.md). -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lss.App\Lss.App.csproj" />
  </ItemGroup>

</Project>
