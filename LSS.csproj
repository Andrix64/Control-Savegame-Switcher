<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LSS</AssemblyName>
    <RootNamespace>Lss</RootNamespace>
    <!-- I test e la prova di Avalonia hanno il loro progetto. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;dist/**;scripts/**;spike/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dati del prodotto: compaiono nelle proprietà dell'exe. Version è l'unica da cambiare a ogni rilascio. -->
    <Version>0.9.0</Version>
    <Product>Local Save Switcher</Product>
    <AssemblyTitle>Local Save Switcher</AssemblyTitle>
    <Description>Più partite per i giochi Steam (per ora solo Control).</Description>
    <Company>Andrix64</Company>
    <Authors>Andrix64</Authors>
    <Copyright>© 2026 Andrix64</Copyright>
    <!-- Testi in inglese in Strings.resx, italiano in Strings.it.resx: la lingua segue Windows. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!--
      Smart App Control giudica ogni dll non firmata in base al suo hash e a
      volte blocca una build. Con una build non deterministica ogni compilazione
      produce un file diverso: se una viene bloccata, basta ricompilare.
    -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icona delle finestre (Theme.AppIcon). -->
    <EmbeddedResource Include="app.ico" LogicalName="Lss.app.ico" />

    <!-- Genera la classe Strings dai testi, senza bisogno di Visual Studio. -->
    <EmbeddedResource Update="Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="Strings"
                      StronglyTypedNamespace="Lss"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lss.Tests" />
  </ItemGroup>

</Project>
