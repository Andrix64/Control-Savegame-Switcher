{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local Save Switcher (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0-windows/LSS.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Collega a processo",
      "type": "coreclr",
      "request": "attach",
      "processName": "LSS.exe"
    }
  ]
}
