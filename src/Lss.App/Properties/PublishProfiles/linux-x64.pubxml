<?xml version="1.0" encoding="utf-8"?>
<!--
  Exe singolo per Linux a 64 bit, con il runtime .NET incluso: chi lo scarica
  non deve installare nulla. Uso:
    dotnet publish src/Lss.App/Lss.App.csproj -p:PublishProfile=linux-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Le librerie native (Avalonia, SkiaSharp) vanno dentro l'exe, non accanto. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Simboli dentro l'exe: gli errori nel registro hanno i numeri di riga. -->
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\bin\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
